# Twitter API v2 Credentials
# ===========================
# Copy this file to .env and fill in your credentials
# Get credentials from: https://developer.twitter.com/en/portal/dashboard
#
# IMPORTANT: Never commit your .env file to version control!

# OAuth 2.0 Bearer Token (App-Only Authentication)
# ------------------------------------------------
# Use for: Search, user lookup, tweet lookup, and other read-only operations
# How to get: Developer Portal > Your App > Keys and Tokens > Bearer Token
TWITTER_BEARER_TOKEN=your_bearer_token_here

# OAuth 1.0a Credentials (User Context Authentication)
# ----------------------------------------------------
# Use for: Posting tweets, following, liking, retweeting, DMs
# Required for any action that modifies data on behalf of a user

# API Key and Secret (also called Consumer Key/Secret)
# How to get: Developer Portal > Your App > Keys and Tokens > API Key and Secret
TWITTER_API_KEY=your_api_key_here
TWITTER_API_SECRET=your_api_secret_here

# Access Token and Secret
# How to get: Developer Portal > Your App > Keys and Tokens > Access Token and Secret
# Note: Generate these with "Read and Write" permissions for full functionality
TWITTER_ACCESS_TOKEN=your_access_token_here
TWITTER_ACCESS_SECRET=your_access_secret_here

# Optional: OAuth 2.0 User Authentication (PKCE Flow)
# ---------------------------------------------------
# Use for: Third-party apps that need user authorization
# These are typically generated during the OAuth flow, not stored statically
# TWITTER_CLIENT_ID=your_client_id_here
# TWITTER_CLIENT_SECRET=your_client_secret_here
